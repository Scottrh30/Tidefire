{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidefire",
  "version": "0.2.0",
  "identifier": "com.tidefire.app",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../app", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../app" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tidefire",
        "width": 1520,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#141518"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "GPU fire, smoke and water VFX",
    "longDescription": "Tidefire simulates fire, smoke and water on the GPU and exports PNG sequences for compositing.",
    "fileAssociations": [
      { "ext": ["tidefire"], "name": "Tidefire Scene", "description": "Tidefire scene", "role": "Editor", "mimeType": "application/x-tidefire" }
    ],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
